{
  "name": "firstapp",
  "version": "1.0.0",
  "description": "My first SAP app",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "cdsbdw": "cds build && cds deploy --to hana && cds watch --profile hybrid",
    "watch-firstapp": "cds watch --open firstapp/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy firstapp --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "dependencies": {
    "@cap-js/hana": "^3",
    "@cap-js/sqlite": "^3.1.0",
    "@sap/cds": "^10.1.0",
    "@sap/cds-dk": "^10.1.0",
    "@sap/xssec": "^4.15.0"
  },
  "devDependencies": {
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0",
    "rimraf": "^5.0.5",
    "mbt": "^1.2.49"
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/firstapp"
  ]
}
